    {
      "dot": "cyan",
      "title": "Entry points & governance",
      "items": [
        "omni-gateway serves HTTP :8080 or runs behind --stdio; omni / aifx CLIs link the same lib",
        "React Fleet & Studio UI served from ui/dist with OIDC/JWKS, role-scoped access",
        "ABAC charter policies, 16-shard rate limiting, DFA PII redaction, Merkle-chained audit"
      ]
    },
    {
      "dot": "emerald",
      "title": "Data & control plane",
      "items": [
        "CoW Arc routing table with canary routing, fallback, circuit breakers",
        "In-memory config cache plus semantic TTL response cache",
        "MCPRegistry diff / approval / rollback backed by a durable WAL store",
        "IDL AutoCrawler turns Protobuf / Thrift / OpenAPI into MCP tools"
      ]
    },
    {
      "dot": "violet",
      "title": "Code Mode & external fleet",
      "items": [
        "In-process AST VM (~100 µs) with optional wasmi sandbox",
        "SSA auto-parallelization, columnar pushdown, resumable continuations",
        "HITL approval gates with LIFO Saga rollback",
        "stdio subprocesses under omni-process-guard; secrets from {env:} / {file:} only"
      ]
    }
  ]
