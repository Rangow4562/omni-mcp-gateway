# Omni MCP Enterprise Configuration Template
OMNI_ENV=production
OMNI_HOST=0.0.0.0
OMNI_PORT=8080
OMNI_LOG_LEVEL=INFO
OMNI_DATA_DIR=~/.omni/data
OMNI_CACHE_REFRESH_INTERVAL=2.0
OMNI_DEFAULT_RATE_LIMIT_RPM=1200
OMNI_MAX_BODY_SIZE_BYTES=10485760
OMNI_ENABLE_PII_REDACTION=true
OMNI_CORS_ORIGINS=*
OMNI_AUTH_SECRET=your_production_secret_key_here

