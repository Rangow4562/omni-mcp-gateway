# Omni MCP Enterprise Configuration Template (v6.8.5 Rust Engine)
OMNI_ENV=production
OMNI_HOST=0.0.0.0
OMNI_PORT=8080
OMNI_PUBLIC_BASE_URL=https://mcp.corp.example.com
OMNI_LOG_LEVEL=INFO
OMNI_DATA_DIR=~/.omni/data
OMNI_CACHE_REFRESH_INTERVAL=2.0
OMNI_DEFAULT_RATE_LIMIT_RPM=1200
OMNI_MAX_BODY_SIZE_BYTES=10485760
OMNI_ENABLE_PII_REDACTION=true
OMNI_CORS_ORIGINS=*

# Authentication & Enterprise MCP Auth Enforcement
# Binding to non-loopback (0.0.0.0) requires at least one of OMNI_AUTH_SECRET, OMNI_JWT_SECRET, or OMNI_OIDC_JWKS_URI.
# OMNI_REQUIRE_MCP_AUTH defaults to true on non-loopback hosts and false on loopback.
OMNI_REQUIRE_MCP_AUTH=true
OMNI_AUTH_SECRET=your_production_secret_key_here
# OMNI_JWT_SECRET=your_hs256_jwt_secret
# OMNI_OIDC_JWKS_URI=https://idp.corp.example.com/.well-known/jwks.json
# OMNI_OIDC_ISSUER=https://idp.corp.example.com/
# OMNI_OIDC_AUDIENCE=https://mcp.corp.example.com

# Skills & Built-In Usage Skills Seeding (opt-in; default false)
OMNI_ENABLE_SKILLS_EXTENSION=true
OMNI_SEED_BUILTIN_SKILLS=false

# High-Availability Storage (wal | sqlite | postgres)
OMNI_STORAGE_BACKEND=wal
# OMNI_DATABASE_URL=postgres://omni:secret@pg.corp.internal:5432/omni
OMNI_PG_POOL_SIZE=8

# Runtime & Resilience
OMNI_WORKER_THREADS=16
OMNI_CB_THRESHOLD=5
OMNI_CB_RESET_SEC=30.0
OMNI_SEMANTIC_CACHE_TTL_SEC=15.0
